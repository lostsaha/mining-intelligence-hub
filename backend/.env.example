# PostgreSQL 连接
DATABASE_URL=postgresql://mining:mining_dev_2026@localhost:5432/mining

# LLM 配置（OpenAI 兼容接口；留空 LLM_API_KEY 则回退为关键词启发式过滤）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# OpenAlex（专家发现，Phase 2）。EMAIL 填你的邮箱可进入 polite pool 获得更高速率限制
OPENALEX_EMAIL=
EXPERT_FROM_YEAR=2019
EXPERT_WORKS_PER_QUERY=150
EXPERT_TOP_N=100

# 采集设置
COLLECT_MAX_PER_SOURCE=40
PROCESS_BATCH_SIZE=200
