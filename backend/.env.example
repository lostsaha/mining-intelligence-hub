# PostgreSQL 连接
DATABASE_URL=postgresql://mining:mining_dev_2026@localhost:5432/mining
DB_CONNECT_TIMEOUT=5

# LLM 配置（OpenAI 兼容接口；留空 LLM_API_KEY 则回退为关键词启发式过滤）
# DeepSeek 示例: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=800
LLM_TIMEOUT=90

# 语义检索（可选；需先执行迁移 010/011，并用 embed_backfill 回填）
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIM=1024
# 部分服务商支持 dimensions 入参（如智谱 embedding-3）；bge-m3 传了会 400
EMBEDDINGS_SEND_DIM=0

# 前端跨源白名单（Next 同源 /api 代理后通常无需直连；保留给调试/独立前端）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# 管理端点保护：
# - 生产环境必须设置随机长字符串 ADMIN_TOKEN，并让调用方带 X-Admin-Token；
# - 留空时仅允许本机回环地址 + X-Requested-With: mining-admin（本地开发用）。
ADMIN_TOKEN=
ADMIN_ALLOW_LOOPBACK=1

# 进程内限流（单机 MVP；多 worker 请改用网关/Redis）
ASK_RATE_LIMIT_PER_MIN=20
ADMIN_RATE_LIMIT_PER_MIN=3

# OpenAlex（专家发现，Phase 2）。EMAIL 填你的邮箱可进入 polite pool 获得更高速率限制
OPENALEX_EMAIL=
OPENALEX_API_KEY=
EXPERT_FROM_YEAR=2019
EXPERT_WORKS_PER_QUERY=150
EXPERT_TOP_N=100

# 采集设置
COLLECT_MAX_PER_SOURCE=40
PROCESS_BATCH_SIZE=200
